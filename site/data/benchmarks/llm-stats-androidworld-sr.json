{"record": {"artifacts": [], "categories": ["multimodal", "reasoning", "general", "agents"], "description": {"en": "AndroidWorld Success Rate (SR) benchmark - A dynamic benchmarking environment for autonomous agents operating on Android devices. Evaluates agents on 116 programmatic tasks across 20 real-world Android apps using multimodal inputs (screen screenshots, accessibility trees, and natural language instructions). Measures success rate of agents completing tasks like sending messages, creating calendar events, and navigating mobile interfaces. Published at ICLR 2025. Best current performance: 30.6% success rate (M3A agent) vs 80.0% human performance."}, "key": "llm-stats:androidworld-sr", "modality": "multimodal", "name": "AndroidWorld_SR", "openness": {"code_license": null, "data_license": null, "evidence": [], "status": "unknown"}, "provenance": {"crawl_bundle": "llm_stats_2026-08-17", "crawled_at": "2026-08-17T18:49:35.489925+00:00", "source_url": "https://api.zeroeval.com/leaderboard/benchmarks/androidworld-sr?top_n=500"}, "publisher": null, "released": null, "schema_version": 1, "sizes": [], "slug": "llm-stats-androidworld-sr", "source": "llm_stats", "source_benchmark_id": "androidworld-sr"}, "schema_version": 1, "scores_by_source": {"llm_stats": {"rows": [{"comparable_group": null, "crawled_at": "2026-08-17T18:49:35.489925+00:00", "date_precision": "model_announcement", "key": "llm-stats:androidworld-sr", "model_id": "qwen3.5-35b-a3b", "model_name": "Qwen3.5-35B-A3B", "obs_id": "llm_stats:androidworld-sr:qwen3.5-35b-a3b", "organization": "Qwen", "rank_in_source_response": 1, "raw_value": "0.711", "reported_by": "self_reported", "reported_date": "2026-02-24", "series_id": "llm_stats:androidworld-sr:default", "source_url": "https://api.zeroeval.com/leaderboard/benchmarks/androidworld-sr?top_n=500", "value": 0.711, "value_kind": "number"}, {"comparable_group": null, "crawled_at": "2026-08-17T18:49:35.489925+00:00", "date_precision": "model_announcement", "