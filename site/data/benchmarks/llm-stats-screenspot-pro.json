{"record": {"artifacts": [], "categories": ["multimodal", "spatial_reasoning", "grounding", "vision"], "description": {"en": "ScreenSpot-Pro is a novel GUI grounding benchmark designed to rigorously evaluate the grounding capabilities of multimodal large language models (MLLMs) in professional high-resolution computing environments. The benchmark comprises 1,581 instructions across 23 applications spanning 5 industries and 3 operating systems, featuring authentic high-resolution images from professional domains with expert annotations. Unlike previous benchmarks that focus on cropped screenshots in consumer applications, ScreenSpot-Pro addresses the complexity and diversity of real-world professional software scenarios, revealing significant performance gaps in current MLLM GUI perception capabilities."}, "key": "llm-stats:screenspot-pro", "modality": "multimodal", "name": "ScreenSpot Pro", "openness": {"code_license": null, "data_license": null, "evidence": [], "status": "unknown"}, "provenance": {"crawl_bundle": "llm_stats_2026-08-17", "crawled_at": "2026-08-17T18:49:35.489925+00:00", "source_url": "https://api.zeroeval.com/leaderboard/benchmarks/screenspot-pro?top_n=500"}, "publisher": null, "released": null, "schema_version": 1, "sizes": [], "slug": "llm-stats-screenspot-pro", "source": "llm_stats", "source_benchmark_id": "screenspot-pro"}, "schema_version": 1, "scores_by_source": {"llm_stats": {"rows": [{"comparable_group": null, "crawled_at": "2026-08-17T18:49:35.489925+00:00", "date_precision": "model_announcement", "key": "llm-stats:screenspot-pro", "model_id": "claude-opus-4-8", "model_name": "Claude Opus 4.8", "obs_id": "llm_stats:screenspot-pro:claude-opus-4-8", "organization": "Anthropic", "rank_in_source_response": 1, "raw_value": "0.879", "reported_by": "self_reported", "reported_date": "2026-05-28", "series_id": "llm_stats:screenspot-pro:default", "source_url": "https://api.zeroeval.com/leaderboard/benchmarks/screenspot-pro?top_n=500", "value": 0.879,