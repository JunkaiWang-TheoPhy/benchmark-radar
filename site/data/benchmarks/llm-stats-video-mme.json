{"record": {"artifacts": [], "categories": ["multimodal", "reasoning", "vision"], "description": {"en": "Video-MME is the first-ever comprehensive evaluation benchmark of Multi-modal Large Language Models (MLLMs) in video analysis. It features 900 videos totaling 254 hours with 2,700 human-annotated question-answer pairs across 6 primary visual domains (Knowledge, Film & Television, Sports Competition, Life Record, Multilingual, and others) and 30 subfields. The benchmark evaluates models across diverse temporal dimensions (11 seconds to 1 hour), integrates multi-modal inputs including video frames, subtitles, and audio, and uses rigorous manual labeling by expert annotators for precise assessment."}, "key": "llm-stats:video-mme", "modality": "multimodal", "name": "Video-MME", "openness": {"code_license": null, "data_license": null, "evidence": [], "status": "unknown"}, "provenance": {"crawl_bundle": "llm_stats_2026-08-17", "crawled_at": "2026-08-17T18:49:35.489925+00:00", "source_url": "https://api.zeroeval.com/leaderboard/benchmarks/video-mme?top_n=500"}, "publisher": null, "released": null, "schema_version": 1, "sizes": [], "slug": "llm-stats-video-mme", "source": "llm_stats", "source_benchmark_id": "video-mme"}, "schema_version": 1, "scores_by_source": {"llm_stats": {"rows": [{"comparable_group": null, "crawled_at": "2026-08-17T18:49:35.489925+00:00", "date_precision": "model_announcement", "key": "llm-stats:video-mme", "model_id": "seed-2.1-pro", "model_name": "Seed 2.1 Pro", "obs_id": "llm_stats:video-mme:seed-2.1-pro", "organization": "ByteDance", "rank_in_source_response": 1, "raw_value": "0.892", "reported_by": "self_reported", "reported_date": "2026-06-24", "series_id": "llm_stats:video-mme:default", "source_url": "https://api.zeroeval.com/leaderboard/benchmarks/video-mme?top_n=500", "value": 0.892, "value_kind": "number"}, {"comparable_group": null, "crawled_at": "2026-08-17T18:49:35.489925+00:00", "date_precision": "model_announcement", "key": "llm-stats