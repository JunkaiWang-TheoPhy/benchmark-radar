{"record": {"artifacts": [], "categories": ["reasoning"], "description": {"en": "MuSR (Multistep Soft Reasoning) is a benchmark for evaluating language models on multistep soft reasoning tasks specified in natural language narratives. Created through a neurosymbolic synthetic-to-natural generation algorithm, it generates complex reasoning scenarios like murder mysteries roughly 1000 words in length that challenge current LLMs including GPT-4. The benchmark tests chain-of-thought reasoning capabilities across domains involving commonsense reasoning about physical and social situations."}, "key": "llm-stats:musr", "modality": "text", "name": "MuSR", "openness": {"code_license": null, "data_license": null, "evidence": [], "status": "unknown"}, "provenance": {"crawl_bundle": "llm_stats_2026-08-17", "crawled_at": "2026-08-17T18:49:35.489925+00:00", "source_url": "https://api.zeroeval.com/leaderboard/benchmarks/musr?top_n=500"}, "publisher": null, "released": null, "schema_version": 1, "sizes": [], "slug": "llm-stats-musr", "source": "llm_stats", "source_benchmark_id": "musr"}, "schema_version": 1, "scores_by_source": {"llm_stats": {"rows": [{"comparable_group": null, "crawled_at": "2026-08-17T18:49:35.489925+00:00", "date_precision": "model_announcement", "key": "llm-stats:musr", "model_id": "kimi-k2-instruct", "model_name": "Kimi K2 Instruct", "obs_id": "llm_stats:musr:kimi-k2-instruct", "organization": "Moonshot AI", "rank_in_source_response": 1, "raw_value": "0.764", "reported_by": "self_reported", "reported_date": "2025-07-11", "series_id": "llm_stats:musr:default", "source_url": "https://api.zeroeval.com/leaderboard/benchmarks/musr?top_n=500", "value": 0.764, "value_kind": "number"}, {"comparable_group": null, "crawled_at": "2026-08-17T18:49:35.489925+00:00", "date_precision": "model_announcement", "key": "llm-stats:musr", "model_id": "hermes-3-70b", "model_name": "Hermes 3 70B", "obs_id": "llm_stats:musr:hermes-3-70b", "organization": "Nous Research", "rank_in_sour