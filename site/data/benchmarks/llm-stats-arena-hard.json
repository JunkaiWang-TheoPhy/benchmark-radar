{"record": {"artifacts": [], "categories": ["reasoning", "general", "creativity", "writing"], "description": {"en": "Arena-Hard-Auto is an automatic evaluation benchmark for instruction-tuned LLMs consisting of 500 challenging real-world prompts curated by BenchBuilder. It includes open-ended software engineering problems, mathematical questions, and creative writing tasks. The benchmark uses LLM-as-a-Judge methodology with GPT-4.1 and Gemini-2.5 as automatic judges to approximate human preference. Arena-Hard achieves 98.6% correlation with human preference rankings and provides 3x higher separation of model performances compared to MT-Bench, making it highly effective for distinguishing between models of similar quality."}, "key": "llm-stats:arena-hard", "modality": "text", "name": "Arena Hard", "openness": {"code_license": null, "data_license": null, "evidence": [], "status": "unknown"}, "provenance": {"crawl_bundle": "llm_stats_2026-08-17", "crawled_at": "2026-08-17T18:49:35.489925+00:00", "source_url": "https://api.zeroeval.com/leaderboard/benchmarks/arena-hard?top_n=500"}, "publisher": null, "released": null, "schema_version": 1, "sizes": [], "slug": "llm-stats-arena-hard", "source": "llm_stats", "source_benchmark_id": "arena-hard"}, "schema_version": 1, "scores_by_source": {"llm_stats": {"rows": [{"comparable_group": null, "crawled_at": "2026-08-17T18:49:35.489925+00:00", "date_precision": "model_announcement", "key": "llm-stats:arena-hard", "model_id": "qwen3-235b-a22b", "model_name": "Qwen3 235B A22B", "obs_id": "llm_stats:arena-hard:qwen3-235b-a22b", "organization": "Qwen", "rank_in_source_response": 1, "raw_value": "0.956", "reported_by": "self_reported", "reported_date": "2025-04-29", "series_id": "llm_stats:arena-hard:default", "source_url": "https://api.zeroeval.com/leaderboard/benchmarks/arena-hard?top_n=500", "value": 0.956, "value_kind": "number"}, {"comparable_group": null, "crawled_at": "2026-08-17T18:49:35.489925+00:00", "date_precision": "model_a