{"record": {"artifacts": [], "categories": ["long_context", "reasoning", "code"], "description": {"en": "RepoQA is a benchmark for evaluating long-context code understanding capabilities of Large Language Models through the Searching Needle Function (SNF) task, where LLMs must locate specific functions in code repositories using natural language descriptions. The benchmark contains 500 code search tasks spanning 50 repositories across 5 modern programming languages (Python, Java, TypeScript, C++, and Rust), tested on 26 general and code-specific LLMs to assess their ability to comprehend and navigate code repositories."}, "key": "llm-stats:repoqa", "modality": "text", "name": "RepoQA", "openness": {"code_license": null, "data_license": null, "evidence": [], "status": "unknown"}, "provenance": {"crawl_bundle": "llm_stats_2026-08-17", "crawled_at": "2026-08-17T18:49:35.489925+00:00", "source_url": "https://api.zeroeval.com/leaderboard/benchmarks/repoqa?top_n=500"}, "publisher": null, "released": null, "schema_version": 1, "sizes": [], "slug": "llm-stats-repoqa", "source": "llm_stats", "source_benchmark_id": "repoqa"}, "schema_version": 1, "scores_by_source": {"llm_stats": {"rows": [{"comparable_group": null, "crawled_at": "2026-08-17T18:49:35.489925+00:00", "date_precision": "model_announcement", "key": "llm-stats:repoqa", "model_id": "phi-3.5-moe-instruct", "model_name": "Phi-3.5-MoE-instruct", "obs_id": "llm_stats:repoqa:phi-3.5-moe-instruct", "organization": "Microsoft", "rank_in_source_response": 1, "raw_value": "0.85", "reported_by": "self_reported", "reported_date": "2024-08-23", "series_id": "llm_stats:repoqa:default", "source_url": "https://api.zeroeval.com/leaderboard/benchmarks/repoqa?top_n=500", "value": 0.85, "value_kind": "number"}, {"comparable_group": null, "crawled_at": "2026-08-17T18:49:35.489925+00:00", "date_precision": "model_announcement", "key": "llm-stats:repoqa", "model_id": "phi-3.5-mini-instruct", "model_name": "Phi-3.5-mini-instruct", "obs_i