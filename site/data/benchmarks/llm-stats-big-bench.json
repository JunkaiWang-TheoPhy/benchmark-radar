{"record": {"artifacts": [], "categories": ["math", "reasoning", "language"], "description": {"en": "Beyond the Imitation Game Benchmark (BIG-bench) is a collaborative benchmark consisting of 204+ tasks designed to probe large language models and extrapolate their future capabilities. It covers diverse domains including linguistics, mathematics, common-sense reasoning, biology, physics, social bias, software development, and more. The benchmark focuses on tasks believed to be beyond current language model capabilities and includes both English and non-English tasks across multiple languages."}, "key": "llm-stats:big-bench", "modality": "text", "name": "BIG-Bench", "openness": {"code_license": null, "data_license": null, "evidence": [], "status": "unknown"}, "provenance": {"crawl_bundle": "llm_stats_2026-08-17", "crawled_at": "2026-08-17T18:49:35.489925+00:00", "source_url": "https://api.zeroeval.com/leaderboard/benchmarks/big-bench?top_n=500"}, "publisher": null, "released": null, "schema_version": 1, "sizes": [], "slug": "llm-stats-big-bench", "source": "llm_stats", "source_benchmark_id": "big-bench"}, "schema_version": 1, "scores_by_source": {"llm_stats": {"rows": [{"comparable_group": null, "crawled_at": "2026-08-17T18:49:35.489925+00:00", "date_precision": "model_announcement", "key": "llm-stats:big-bench", "model_id": "gemini-1.0-pro", "model_name": "Gemini 1.0 Pro", "obs_id": "llm_stats:big-bench:gemini-1.0-pro", "organization": "Google", "rank_in_source_response": 1, "raw_value": "0.75", "reported_by": "third_party", "reported_date": "2024-02-15", "series_id": "llm_stats:big-bench:default", "source_url": "https://api.zeroeval.com/leaderboard/benchmarks/big-bench?top_n=500", "value": 0.75, "value_kind": "number"}, {"comparable_group": null, "crawled_at": "2026-08-17T18:49:35.489925+00:00", "date_precision": "model_announcement", "key": "llm-stats:big-bench", "model_id": "gemma-2-27b-it", "model_name": "Gemma 2 27B", "obs_id": "llm_stats:big-bench:gemma-2-27b-i