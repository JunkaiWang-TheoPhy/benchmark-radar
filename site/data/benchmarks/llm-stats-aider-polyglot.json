{"record": {"artifacts": [], "categories": ["general", "code"], "description": {"en": "A coding benchmark that evaluates LLMs on 225 challenging Exercism programming exercises across C++, Go, Java, JavaScript, Python, and Rust. Models receive two attempts to solve each problem, with test error feedback provided after the first attempt if it fails. The benchmark measures both initial problem-solving ability and capacity to edit code based on error feedback, providing an end-to-end evaluation of code generation and editing capabilities across multiple programming languages."}, "key": "llm-stats:aider-polyglot", "modality": "text", "name": "Aider-Polyglot", "openness": {"code_license": null, "data_license": null, "evidence": [], "status": "unknown"}, "provenance": {"crawl_bundle": "llm_stats_2026-08-17", "crawled_at": "2026-08-17T18:49:35.489925+00:00", "source_url": "https://api.zeroeval.com/leaderboard/benchmarks/aider-polyglot?top_n=500"}, "publisher": null, "released": null, "schema_version": 1, "sizes": [], "slug": "llm-stats-aider-polyglot", "source": "llm_stats", "source_benchmark_id": "aider-polyglot"}, "schema_version": 1, "scores_by_source": {"llm_stats": {"rows": [{"comparable_group": null, "crawled_at": "2026-08-17T18:49:35.489925+00:00", "key": "llm-stats:aider-polyglot", "model_id": "gpt-5-2025-08-07", "model_name": "GPT-5", "obs_id": "llm_stats:aider-polyglot:gpt-5-2025-08-07", "organization": "OpenAI", "rank_in_source_response": 1, "raw_value": "0.88", "reported_by": "self_reported", "reported_date": null, "series_id": "llm_stats:aider-polyglot:default", "source_url": "https://api.zeroeval.com/leaderboard/benchmarks/aider-polyglot?top_n=500", "value": 0.88, "value_kind": "number"}, {"comparable_group": null, "crawled_at": "2026-08-17T18:49:35.489925+00:00", "key": "llm-stats:aider-polyglot", "model_id": "gemini-2.5-pro-preview-06-05", "model_name": "Gemini 2.5 Pro Preview 06-05", "obs_id": "llm_stats:aider-polyglot:gemini-2.5-pro-preview-06-05", "organi