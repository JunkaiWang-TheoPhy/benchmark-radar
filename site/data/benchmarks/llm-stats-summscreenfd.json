{"record": {"artifacts": [], "categories": ["long_context", "summarization"], "description": {"en": "SummScreenFD is the ForeverDreaming subset of the SummScreen dataset for abstractive screenplay summarization, comprising pairs of TV series transcripts and human-written recaps from 88 different shows. The dataset provides a challenging testbed for abstractive summarization where plot details are often expressed indirectly in character dialogues and scattered across the entirety of the transcript, requiring models to find and integrate these details to form succinct plot descriptions."}, "key": "llm-stats:summscreenfd", "modality": "text", "name": "SummScreenFD", "openness": {"code_license": null, "data_license": null, "evidence": [], "status": "unknown"}, "provenance": {"crawl_bundle": "llm_stats_2026-08-17", "crawled_at": "2026-08-17T18:49:35.489925+00:00", "source_url": "https://api.zeroeval.com/leaderboard/benchmarks/summscreenfd?top_n=500"}, "publisher": null, "released": null, "schema_version": 1, "sizes": [], "slug": "llm-stats-summscreenfd", "source": "llm_stats", "source_benchmark_id": "summscreenfd"}, "schema_version": 1, "scores_by_source": {"llm_stats": {"rows": [{"comparable_group": null, "crawled_at": "2026-08-17T18:49:35.489925+00:00", "date_precision": "model_announcement", "key": "llm-stats:summscreenfd", "model_id": "phi-3.5-moe-instruct", "model_name": "Phi-3.5-MoE-instruct", "obs_id": "llm_stats:summscreenfd:phi-3.5-moe-instruct", "organization": "Microsoft", "rank_in_source_response": 1, "raw_value": "0.169", "reported_by": "self_reported", "reported_date": "2024-08-23", "series_id": "llm_stats:summscreenfd:default", "source_url": "https://api.zeroeval.com/leaderboard/benchmarks/summscreenfd?top_n=500", "value": 0.169, "value_kind": "number"}, {"comparable_group": null, "crawled_at": "2026-08-17T18:49:35.489925+00:00", "date_precision": "model_announcement", "key": "llm-stats:summscreenfd", "model_id": "phi-3.5-mini-instruct", "model_name": "Phi