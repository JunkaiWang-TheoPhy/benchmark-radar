{"record": {"artifacts": [], "categories": ["long_context", "reasoning", "structured_output", "general"], "description": {"en": "LongBench v2 is a benchmark designed to assess the ability of LLMs to handle long-context problems requiring deep understanding and reasoning across real-world multitasks. It consists of 503 challenging multiple-choice questions with contexts ranging from 8k to 2M words across six major task categories: single-document QA, multi-document QA, long in-context learning, long-dialogue history understanding, code repository understanding, and long structured data understanding."}, "key": "llm-stats:longbench-v2", "modality": "text", "name": "LongBench v2", "openness": {"code_license": null, "data_license": null, "evidence": [], "status": "unknown"}, "provenance": {"crawl_bundle": "llm_stats_2026-08-17", "crawled_at": "2026-08-17T18:49:35.489925+00:00", "source_url": "https://api.zeroeval.com/leaderboard/benchmarks/longbench-v2?top_n=500"}, "publisher": null, "released": null, "schema_version": 1, "sizes": [], "slug": "llm-stats-longbench-v2", "source": "llm_stats", "source_benchmark_id": "longbench-v2"}, "schema_version": 1, "scores_by_source": {"llm_stats": {"rows": [{"comparable_group": null, "crawled_at": "2026-08-17T18:49:35.489925+00:00", "date_precision": "model_announcement", "key": "llm-stats:longbench-v2", "model_id": "qwen3.8-max", "model_name": "Qwen3.8 Max", "obs_id": "llm_stats:longbench-v2:qwen3.8-max", "organization": "Qwen", "rank_in_source_response": 1, "raw_value": "0.663", "reported_by": "self_reported", "reported_date": "2026-08-02", "series_id": "llm_stats:longbench-v2:default", "source_url": "https://api.zeroeval.com/leaderboard/benchmarks/longbench-v2?top_n=500", "value": 0.663, "value_kind": "number"}, {"comparable_group": null, "crawled_at": "2026-08-17T18:49:35.489925+00:00", "date_precision": "model_announcement", "key": "llm-stats:longbench-v2", "model_id": "qwen3.5-397b-a17b", "model_name": "Qwen3.5-397B-A17B", "obs