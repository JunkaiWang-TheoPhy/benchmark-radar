{"record": {"artifacts": [], "categories": ["reasoning", "communication"], "description": {"en": "MultiChallenge is a realistic multi-turn conversation evaluation benchmark that challenges frontier LLMs across four key categories: instruction retention (maintaining instructions throughout conversations), inference memory (recalling and connecting details from previous turns), reliable versioned editing (adapting to evolving instructions during collaborative editing), and self-coherence (avoiding contradictions in responses). The benchmark evaluates models on sustained, contextually complex dialogues across diverse topics including travel planning, technical documentation, and professional communication."}, "key": "llm-stats:multichallenge", "modality": "text", "name": "Multi-Challenge", "openness": {"code_license": null, "data_license": null, "evidence": [], "status": "unknown"}, "provenance": {"crawl_bundle": "llm_stats_2026-08-17", "crawled_at": "2026-08-17T18:49:35.489925+00:00", "source_url": "https://api.zeroeval.com/leaderboard/benchmarks/multichallenge?top_n=500"}, "publisher": null, "released": null, "schema_version": 1, "sizes": [], "slug": "llm-stats-multichallenge", "source": "llm_stats", "source_benchmark_id": "multichallenge"}, "schema_version": 1, "scores_by_source": {"llm_stats": {"rows": [{"comparable_group": null, "crawled_at": "2026-08-17T18:49:35.489925+00:00", "key": "llm-stats:multichallenge", "model_id": "nova-2-pro", "model_name": "Nova 2 Pro", "obs_id": "llm_stats:multichallenge:nova-2-pro", "organization": "Amazon", "rank_in_source_response": 1, "raw_value": "0.777", "reported_by": "self_reported", "reported_date": null, "series_id": "llm_stats:multichallenge:default", "source_url": "https://api.zeroeval.com/leaderboard/benchmarks/multichallenge?top_n=500", "value": 0.777, "value_kind": "number"}, {"comparable_group": null, "crawled_at": "2026-08-17T18:49:35.489925+00:00", "key": "llm-stats:multichallenge", "model_id": "nova-2-lite", "model_