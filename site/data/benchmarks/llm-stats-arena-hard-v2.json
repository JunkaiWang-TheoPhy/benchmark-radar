{"record": {"artifacts": [], "categories": ["reasoning", "general", "creativity", "writing"], "description": {"en": "Arena-Hard-Auto v2 is a challenging benchmark consisting of 500 carefully curated prompts sourced from Chatbot Arena and WildChat-1M, designed to evaluate large language models on real-world user queries. The benchmark covers diverse domains including open-ended software engineering problems, mathematics, creative writing, and technical problem-solving. It uses LLM-as-a-Judge for automatic evaluation, achieving 98.6% correlation with human preference rankings while providing 3x higher separation of model performances compared to MT-Bench. The benchmark emphasizes prompt specificity, complexity, and domain knowledge to better distinguish between model capabilities."}, "key": "llm-stats:arena-hard-v2", "modality": "text", "name": "Arena-Hard v2", "openness": {"code_license": null, "data_license": null, "evidence": [], "status": "unknown"}, "provenance": {"crawl_bundle": "llm_stats_2026-08-17", "crawled_at": "2026-08-17T18:49:35.489925+00:00", "source_url": "https://api.zeroeval.com/leaderboard/benchmarks/arena-hard-v2?top_n=500"}, "publisher": null, "released": null, "schema_version": 1, "sizes": [], "slug": "llm-stats-arena-hard-v2", "source": "llm_stats", "source_benchmark_id": "arena-hard-v2"}, "schema_version": 1, "scores_by_source": {"llm_stats": {"rows": [{"comparable_group": null, "crawled_at": "2026-08-17T18:49:35.489925+00:00", "date_precision": "model_announcement", "key": "llm-stats:arena-hard-v2", "model_id": "mimo-v2-flash", "model_name": "MiMo-V2-Flash", "obs_id": "llm_stats:arena-hard-v2:mimo-v2-flash", "organization": "Xiaomi", "rank_in_source_response": 1, "raw_value": "0.862", "reported_by": "self_reported", "reported_date": "2025-12-16", "series_id": "llm_stats:arena-hard-v2:default", "source_url": "https://api.zeroeval.com/leaderboard/benchmarks/arena-hard-v2?top_n=500", "value": 0.862, "value_kind": "number"}, {"comparable_group": n