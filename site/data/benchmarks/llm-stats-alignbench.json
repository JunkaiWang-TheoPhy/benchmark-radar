{"record": {"artifacts": [], "categories": ["math", "reasoning", "roleplay", "language", "general", "creativity", "writing"], "description": {"en": "AlignBench is a comprehensive multi-dimensional benchmark for evaluating Chinese alignment of Large Language Models. It contains 8 main categories: Fundamental Language Ability, Advanced Chinese Understanding, Open-ended Questions, Writing Ability, Logical Reasoning, Mathematics, Task-oriented Role Play, and Professional Knowledge. The benchmark includes 683 real-scenario rooted queries with human-verified references and uses a rule-calibrated multi-dimensional LLM-as-Judge approach with Chain-of-Thought for evaluation."}, "key": "llm-stats:alignbench", "modality": "text", "name": "AlignBench", "openness": {"code_license": null, "data_license": null, "evidence": [], "status": "unknown"}, "provenance": {"crawl_bundle": "llm_stats_2026-08-17", "crawled_at": "2026-08-17T18:49:35.489925+00:00", "source_url": "https://api.zeroeval.com/leaderboard/benchmarks/alignbench?top_n=500"}, "publisher": null, "released": null, "schema_version": 1, "sizes": [], "slug": "llm-stats-alignbench", "source": "llm_stats", "source_benchmark_id": "alignbench"}, "schema_version": 1, "scores_by_source": {"llm_stats": {"rows": [{"comparable_group": null, "crawled_at": "2026-08-17T18:49:35.489925+00:00", "date_precision": "model_announcement", "key": "llm-stats:alignbench", "model_id": "qwen-2.5-72b-instruct", "model_name": "Qwen2.5 72B Instruct", "obs_id": "llm_stats:alignbench:qwen-2.5-72b-instruct", "organization": "Qwen", "rank_in_source_response": 1, "raw_value": "0.816", "reported_by": "self_reported", "reported_date": "2024-09-19", "series_id": "llm_stats:alignbench:default", "source_url": "https://api.zeroeval.com/leaderboard/benchmarks/alignbench?top_n=500", "value": 0.816, "value_kind": "number"}, {"comparable_group": null, "crawled_at": "2026-08-17T18:49:35.489925+00:00", "date_precision": "model_announcement", "key": "llm-stats:alignben