{"record": {"artifacts": [], "categories": ["reasoning", "code"], "description": {"en": "Aider is a comprehensive code editing benchmark based on 133 practice exercises from Exercism's Python repository, designed to evaluate AI models' ability to translate natural language coding requests into executable code that passes unit tests. The benchmark measures end-to-end code editing capabilities, including GPT's ability to edit existing code and format code changes for automated saving to local files. The Aider Polyglot variant extends this evaluation across 225 challenging exercises spanning C++, Go, Java, JavaScript, Python, and Rust, making it a standard benchmark for assessing multilingual code editing performance in AI research."}, "key": "llm-stats:aider", "modality": "text", "name": "Aider", "openness": {"code_license": null, "data_license": null, "evidence": [], "status": "unknown"}, "provenance": {"crawl_bundle": "llm_stats_2026-08-17", "crawled_at": "2026-08-17T18:49:35.489925+00:00", "source_url": "https://api.zeroeval.com/leaderboard/benchmarks/aider?top_n=500"}, "publisher": null, "released": null, "schema_version": 1, "sizes": [], "slug": "llm-stats-aider", "source": "llm_stats", "source_benchmark_id": "aider"}, "schema_version": 1, "scores_by_source": {"llm_stats": {"rows": [{"comparable_group": null, "crawled_at": "2026-08-17T18:49:35.489925+00:00", "key": "llm-stats:aider", "model_id": "deepseek-v2.5", "model_name": "DeepSeek-V2.5", "obs_id": "llm_stats:aider:deepseek-v2.5", "organization": "DeepSeek", "rank_in_source_response": 1, "raw_value": "0.722", "reported_by": "self_reported", "reported_date": null, "series_id": "llm_stats:aider:default", "source_url": "https://api.zeroeval.com/leaderboard/benchmarks/aider?top_n=500", "value": 0.722, "value_kind": "number"}, {"comparable_group": null, "crawled_at": "2026-08-17T18:49:35.489925+00:00", "key": "llm-stats:aider", "model_id": "qwen3-235b-a22b", "model_name": "Qwen3 235B A22B", "obs_id": "llm_stats:ai