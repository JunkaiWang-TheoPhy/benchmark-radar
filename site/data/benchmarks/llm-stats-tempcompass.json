{"record": {"artifacts": [], "categories": ["multimodal", "reasoning", "vision"], "description": {"en": "TempCompass is a comprehensive benchmark for evaluating temporal perception capabilities of Video Large Language Models (Video LLMs). It constructs conflicting videos that share identical static content but differ in specific temporal aspects to prevent models from exploiting single-frame bias. The benchmark evaluates multiple temporal aspects including action, motion, speed, temporal order, and attribute changes across diverse task formats including multi-choice QA, yes/no QA, caption matching, and caption generation."}, "key": "llm-stats:tempcompass", "modality": "multimodal", "name": "TempCompass", "openness": {"code_license": null, "data_license": null, "evidence": [], "status": "unknown"}, "provenance": {"crawl_bundle": "llm_stats_2026-08-17", "crawled_at": "2026-08-17T18:49:35.489925+00:00", "source_url": "https://api.zeroeval.com/leaderboard/benchmarks/tempcompass?top_n=500"}, "publisher": null, "released": null, "schema_version": 1, "sizes": [], "slug": "llm-stats-tempcompass", "source": "llm_stats", "source_benchmark_id": "tempcompass"}, "schema_version": 1, "scores_by_source": {"llm_stats": {"rows": [{"comparable_group": null, "crawled_at": "2026-08-17T18:49:35.489925+00:00", "date_precision": "model_announcement", "key": "llm-stats:tempcompass", "model_id": "qwen2.5-vl-72b", "model_name": "Qwen2.5 VL 72B Instruct", "obs_id": "llm_stats:tempcompass:qwen2.5-vl-72b", "organization": "Qwen", "rank_in_source_response": 1, "raw_value": "0.748", "reported_by": "self_reported", "reported_date": "2025-01-26", "series_id": "llm_stats:tempcompass:default", "source_url": "https://api.zeroeval.com/leaderboard/benchmarks/tempcompass?top_n=500", "value": 0.748, "value_kind": "number"}, {"comparable_group": null, "crawled_at": "2026-08-17T18:49:35.489925+00:00", "date_precision": "model_announcement", "key": "llm-stats:tempcompass", "model_id": "qwen2.5-vl-7b", "model