{"record": {"artifacts": [], "categories": ["reasoning", "general", "creativity", "writing"], "description": {"en": "AlpacaEval 2.0 is a length-controlled automatic evaluator for instruction-following language models that uses GPT-4 Turbo to assess model responses against a baseline. It evaluates models on 805 diverse instruction-following tasks including creative writing, classification, programming, and general knowledge questions. The benchmark achieves 0.98 Spearman correlation with ChatBot Arena while being fast (< 3 minutes) and affordable (< $10 in OpenAI credits). It addresses length bias in automatic evaluation through length-controlled win-rates and uses weighted scoring based on response quality."}, "key": "llm-stats:alpacaeval-2.0", "modality": "text", "name": "AlpacaEval 2.0", "openness": {"code_license": null, "data_license": null, "evidence": [], "status": "unknown"}, "provenance": {"crawl_bundle": "llm_stats_2026-08-17", "crawled_at": "2026-08-17T18:49:35.489925+00:00", "source_url": "https://api.zeroeval.com/leaderboard/benchmarks/alpacaeval-2.0?top_n=500"}, "publisher": null, "released": null, "schema_version": 1, "sizes": [], "slug": "llm-stats-alpacaeval-2-0", "source": "llm_stats", "source_benchmark_id": "alpacaeval-2.0"}, "schema_version": 1, "scores_by_source": {"llm_stats": {"rows": [{"comparable_group": null, "crawled_at": "2026-08-17T18:49:35.489925+00:00", "date_precision": "model_announcement", "key": "llm-stats:alpacaeval-2.0", "model_id": "granite-3.3-8b-base", "model_name": "Granite 3.3 8B Base", "obs_id": "llm_stats:alpacaeval-2.0:granite-3.3-8b-base", "organization": "IBM", "rank_in_source_response": 1, "raw_value": "0.6268", "reported_by": "self_reported", "reported_date": "2025-04-16", "series_id": "llm_stats:alpacaeval-2.0:default", "source_url": "https://api.zeroeval.com/leaderboard/benchmarks/alpacaeval-2.0?top_n=500", "value": 0.6268, "value_kind": "number"}, {"comparable_group": null, "crawled_at": "2026-08-17T18:49:35.489925+